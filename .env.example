# Copy to .env and fill in. Every setting the system uses is listed here (12-factor).
# Settings for later phases are listed now, commented, so the full picture is visible.
# In production the same names are set as HF Space secrets and Cloudflare Worker secrets.

# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=local            # local | ci | production
LOG_LEVEL=INFO

# ---- Postgres (ADR-0007): one role + schema per module --------------------
# Local passwords. Generate real ones with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-postgres
BANK_DB_PASSWORD=change-me-bank
ORCHESTRATOR_DB_PASSWORD=change-me-orchestrator
# Production (Neon) sets full URLs instead:
# BANK_DATABASE_URL=postgresql://bank_api:...@<neon-host>/voiceref?sslmode=require
# ORCHESTRATOR_DATABASE_URL=postgresql://orchestrator:...@<neon-host>/voiceref?sslmode=require

# ---- Host ports (local only) ----------------------------------------------
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=7860
# WEB_HOST_PORT=3000

# ---- Tokens (ADR-0006) ------------------------------------------------------
# Signs session and confirmation tokens. At least 32 bytes. openssl rand -hex 32
TOKEN_SIGNING_KEY=change-me-to-a-random-32-byte-hex-string-000000

# ---- Web BFF (ADR-0011) ---------------------------------------------------
# BACKEND_URL=https://<user>-voice-ref-backend.hf.space   # set by compose locally
# BACKEND_TOKEN=hf_...       # read token for the private Space; unset locally

# ---- LLM, System 2 (ADR-0008): any OpenAI-compatible endpoint --------------
# Groq (default):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Key from console.groq.com (gsk_...)
LLM_API_KEY=
# Ollama, native on the Mac (Metal) instead:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2:3b
# LLM_API_KEY=ollama

# ---- Decisions, System 1 (ADR-0005): anything speaking /v1/systemone -------
# Default: Laya as a sidecar inside the backend container (CPU).
SIDECARS=laya
SYSTEM1_URL=http://127.0.0.1:8100
# Faster on a Mac: run Laya natively on the Apple GPU and skip it in the image:
#   uv tool install "laya[serve]" && LAYA_DEVICE=mps LAYA_PORT=8100 LAYA_PRELOAD=1 laya-serve
#   WITH_LAYA=false
#   SIDECARS=
#   SYSTEM1_URL=http://host.docker.internal:8100
# Hosted Jev instead (same wire format): SYSTEM1_URL=<endpoint>, SYSTEM1_API_KEY=...
# No System 1 at all (LLM decides everything): SYSTEM1_ENABLED=false
# DECISION_CONFIDENCE_THRESHOLD=0.85
# CONFIRMATION_CONFIDENCE_THRESHOLD=0.9

# ---- Mock authentication ----------------------------------------------------
DEMO_OTP=123456

# ---- Voice (Phase 2) ------------------------------------------------------
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---- Observability, memory, workflows (Phase 3) ---------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=voice-ref
# SYNAP_API_KEY=             # unset = local Postgres memory
# KESTRA_URL=http://kestra:8080          # production: the Kestra HF Space
# KESTRA_WEBHOOK_SECRET=
