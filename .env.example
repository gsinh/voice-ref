# Copy to .env and fill in. Every setting the system uses is listed here (12-factor).
# Settings for later phases are listed now, commented, so the full picture is visible.

# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=local            # local | ci | production
LOG_LEVEL=INFO

# ---- Secrets (ADR-0019) ------------------------------------------------------
# No secrets in this file. Passwords, database URLs, the token signing key and API keys
# live as files in ./secrets (gitignored, private), created by:  make secrets
# Then put your own keys in secrets/LLM_API_KEY (and secrets/LIVEKIT_API_* for voice).
# In production the same names are set as Hugging Face Space / Cloudflare secrets.

# ---- Host ports (local only) ----------------------------------------------
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=7860
# WEB_HOST_PORT=3000

# ---- Web BFF (ADR-0011) ---------------------------------------------------
# BACKEND_URL=https://<user>-voice-ref-backend.hf.space   # set by compose locally
# BACKEND_TOKEN: read token for the private Space; a Cloudflare secret in production

# ---- LLM, System 2 (ADR-0008): any OpenAI-compatible endpoint --------------
# Groq (default). Groq retired Llama 3.3 70B on 2026-08-16 and has deprecated its other
# Llama models; gpt-oss-120b is its recommended replacement (open weights, tool use).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Key: put it in secrets/LLM_API_KEY (from console.groq.com, gsk_...)
# Ollama, native on the Mac (Metal) instead:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2:3b
# (Ollama needs no key)

# ---- Decisions, System 1 (ADR-0005): anything speaking /v1/systemone -------
# Default: Laya as a sidecar inside the backend container (CPU).
SIDECARS=laya
SYSTEM1_URL=http://127.0.0.1:8100
# Faster on a Mac: run Laya natively on the Apple GPU and skip it in the image:
#   uv tool install "laya[serve]" && LAYA_DEVICE=mps LAYA_PORT=8100 LAYA_PRELOAD=1 laya-serve
#   WITH_LAYA=false
#   SIDECARS=
#   SYSTEM1_URL=http://host.docker.internal:8100
# Hosted Jev instead (same wire format): SYSTEM1_URL=<endpoint>, key in SYSTEM1_API_KEY
# No System 1 at all (LLM decides everything): SYSTEM1_ENABLED=false
# DECISION_CONFIDENCE_THRESHOLD=0.85
# CONFIRMATION_CONFIDENCE_THRESHOLD=0.9

# ---- Mock authentication ----------------------------------------------------
DEMO_OTP=123456

# ---- Voice (Phase 2, ADR-0018) --------------------------------------------
# Turn voice on: add it to SIDECARS (e.g. SIDECARS=laya,voice) and fill in LiveKit.
# LiveKit Cloud: create a project at cloud.livekit.io -> Settings -> Keys.
# LIVEKIT_URL=wss://<project>.livekit.cloud
# Keys: put them in secrets/LIVEKIT_API_KEY and secrets/LIVEKIT_API_SECRET
# LIVEKIT_AGENT_NAME=bank-agent
# STT: any OpenAI-compatible transcription endpoint (Groq Whisper by default).
# STT_API_KEY defaults to LLM_API_KEY, so with Groq there is nothing else to set.
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# TTS: Kokoro runs locally (free; ~420 MB of model files downloaded on first call).
# TTS_PROVIDER=kokoro
# TTS_VOICE=af_heart       # a*/b* = US/UK English, h* = Hindi
# Or any OpenAI-compatible speech endpoint:
# TTS_PROVIDER=openai
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_API_KEY: an extra secret file (secrets/TTS_API_KEY) or env var

# ---- Observability, memory, workflows (Phase 3) ---------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY: secret file (secrets/LANGSMITH_API_KEY)
# LANGSMITH_PROJECT=voice-ref
# SYNAP_API_KEY: secret file; unset = local Postgres memory
# KESTRA_URL=http://kestra:8080          # production: the Kestra HF Space
# KESTRA_WEBHOOK_SECRET: secret file
